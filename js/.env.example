# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/patient_portal

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# API Gateway — optional; when set, added as a server in the Swagger UI
# GATEWAY_BASE_URL=https://your-gateway.example.com
